{
  "name": "CSE3130 DevOps Lab",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu",
  "hostRequirements": { "cpus": 4, "memory": "16gb" },
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {},
    "ghcr.io/devcontainers/features/kubectl-helm-minikube:1": { "minikube": "none" },
    "ghcr.io/devcontainers/features/node:1": { "version": "22" }
  },
  "postCreateCommand": "bash scripts/install-tools.sh",
  "forwardPorts": [3000, 8080, 8081, 3001, 9090],
  "portsAttributes": {
    "3000": { "label": "App (Compose)" },
    "8080": { "label": "App (Kubernetes)" },
    "8081": { "label": "Argo CD" },
    "3001": { "label": "Grafana" },
    "9090": { "label": "Prometheus" }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-azuretools.vscode-docker",
        "ms-kubernetes-tools.vscode-kubernetes-tools",
        "opentofu.vscode-opentofu",
        "dbaeumer.vscode-eslint"
      ]
    }
  }
}
